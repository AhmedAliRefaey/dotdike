@page
@model Dike.Web.Pages.Auth.RegisterModel
@{ ViewData["Title"] = "Register your company"; }
<div class="auth-grid">
    <aside><h1>@T["Your company."]<br />@T["One workspace."]</h1><p>@T["Set up a private workspace for your finance team. You will be its first administrator."]</p>
        <ol class="steps"><li class="current">@T["Create company and administrator"]</li><li>@T["Complete company profile"]</li><li>@T["Open your workspace"]</li></ol>
        <p>@T["Already registered?"] <a asp-page="Login">@T["Sign in"]</a></p>
    </aside>
    <section class="auth-card" aria-labelledby="register-heading"><h2 id="register-heading">@T["Register your company"]</h2>
        <form method="post"><div asp-validation-summary="All" class="validation" role="alert"></div>
            <label asp-for="Input.CompanyName"></label><input asp-for="Input.CompanyName" autocomplete="organization" dir="auto" />
            <label asp-for="Input.ConnectionProvider"></label><select asp-for="Input.ConnectionProvider" required aria-describedby="provider-help"><option value="">@T["Choose a provider"]</option><option value="NetSuite">NetSuite</option><option value="Odoo">Odoo</option></select>
            <small id="provider-help">@T["Your workspace will show only the selected provider. You can change it in Company profile."]</small>
            <label asp-for="Input.FullName"></label><input asp-for="Input.FullName" autocomplete="name" dir="auto" />
            <label asp-for="Input.Email"></label><input asp-for="Input.Email" autocomplete="email" dir="ltr" />
            <label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="new-password" aria-describedby="password-help" dir="ltr" />
            <small id="password-help">@T["Use 12–128 characters with uppercase, lowercase, a number and a symbol."]</small>
            <label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" autocomplete="new-password" dir="ltr" />
            <label class="check"><input asp-for="Input.Authorized" /> @T["I am authorized to register and manage this company."]</label>
            <button class="button form-submit" type="submit">@T["Create company account"] <svg class="icon directional" aria-hidden="true"><use href="#i-arrow" /></svg></button>
            <p class="muted">@T["Your Dike password is separate from your connection credentials."]</p>
        </form>
    </section>
</div>
