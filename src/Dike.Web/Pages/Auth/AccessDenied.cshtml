@page
@{ ViewData["Title"] = "Access denied"; Response.StatusCode = 403; }
<section class="error-state"><div class="empty-icon" aria-hidden="true"><svg class="icon"><use href="#i-shield" /></svg></div><h1>@T["Access denied"]</h1><p>@T["Your company account does not have the role required for this page. Ask your administrator to review your Dike access."]</p><a class="button button-secondary" asp-page="/Index">@T["Return to overview"]</a></section>
