@page
@model Dike.Web.Pages.Auth.ChangePasswordModel
@{ ViewData["Title"] = "Account security"; }
<div class="page-heading"><div><h1>@T["Account security"]</h1><p>@T["Keep access to your workspace in your hands."]</p></div></div>
<div class="form-layout">
    <section class="auth-card" aria-labelledby="password-heading"><h2 id="password-heading">@T["Change password"]</h2>
        <form method="post"><div asp-validation-summary="All" class="validation" role="alert"></div>
            <label asp-for="Input.Current"></label><input asp-for="Input.Current" autocomplete="current-password" dir="ltr" />
            <label asp-for="Input.New"></label><input asp-for="Input.New" autocomplete="new-password" dir="ltr" aria-describedby="password-help" />
            <small id="password-help">@T["Use 12–128 characters with uppercase, lowercase, a number and a symbol."]</small>
            <label asp-for="Input.Confirm"></label><input asp-for="Input.Confirm" autocomplete="new-password" dir="ltr" />
            <button class="button" type="submit">@T["Update password"]</button>
        </form>
    </section>
    <aside class="context-note"><svg class="icon" aria-hidden="true"><use href="#i-lock" /></svg><h2>@T["A separate layer of access"]</h2><p>@T["Your Dike password is separate from your connection credentials."]</p></aside>
</div>
